      <tr><td>5 حصان (3.7 كيلوواط)</td><td class="price">1,000-1,600 دولار</td><td>5-6 كيلوواط ذروة</td><td>80-150 م³/يوم</td><td class="price">3,000-5,000 دولار</td></tr>
